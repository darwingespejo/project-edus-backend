# --- app ---
APP_ENV=production
# Comma-separated: deployed frontend + local dev
ALLOWED_ORIGINS=https://edusphere-web.onrender.com,http://localhost:5173
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# Google Identity Services client ID (also configured in the frontend).
GOOGLE_CLIENT_ID=
# Optional CA bundle for PHP cURL when the host has no configured trust store.
CURL_CA_BUNDLE=
# Gemini study assistant and Pico chat on the learning-path page.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Aiven MySQL ---
DB_DRIVER=mysql
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=16450
DB_USER=avnadmin
DB_PASSWORD=your-password
DB_NAME=edusphere
DB_CHARSET=utf8mb4
# Local path is relative to backend/. Docker deployments should override this
# with the mounted CA path (for example /run/secrets/aiven-ca.pem).
DB_SSL_CA=certs/aiven-ca.pem
APP_URL=http://127.0.0.1:5173

# --- email: Resend preferred; SMTP is used when Resend is not configured ---
RESEND_API_KEY=
MAIL_FROM=
# --- PayMongo: use a test secret key and test webhook signing secret locally ---
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Use tls for STARTTLS, ssl for implicit TLS, or none for unencrypted SMTP.
SMTP_SECURE=tls
MAIL_FROM_ADDRESS=noreply@edusphere.dev
MAIL_FROM_NAME=EduSphere
# Optional: public practice endpoint (submitted code/input is sent to Judge0): https://ce.judge0.com
JUDGE0_URL=
JUDGE0_API_KEY=
# Optional CA bundle when PHP cURL has no trusted system bundle configured.
JUDGE0_CA_BUNDLE=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
